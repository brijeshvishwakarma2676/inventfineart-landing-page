# Copy to a real env file (never commit real values). On Vercel set these in Project -> Settings -> Environment Variables.
# Used only by the serverless function in api/ (server side). Never prefix with VITE_ (that would expose it to the browser).
GROQ_API_KEY=
# Groq model id. Check the current list in the Groq console before choosing one.
GROQ_MODEL=
# Comma-separated origins allowed to call /api/chat, e.g. https://www.inventfineart.com,http://localhost:5173
CHAT_ALLOWED_ORIGINS=
# Soft per-visitor limit (requests per minute) enforced by the function
CHAT_RATE_LIMIT_PER_MIN=10
